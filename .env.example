# Docker / DB
POSTGRES_USER=<your_db_user>
POSTGRES_PASSWORD=<your_db_password>
POSTGRES_DB=<your_db_name>
POSTGRES_HOST=<your_db_host>
# Docker service name — do not change unless you rename the db service
POSTGRES_HOST_PORT=<your_desired_free_host_port>
# Port exposed on your host machine to reach the DB container
POSTGRES_CONTAINER_PORT=5432
# Port Postgres listens on inside the container (default: 5432)

# Docker / API
API_HOST_PORT=<your_desired_api_free_host_port>
# Port exposed on your host machine to reach the API container

# Environment
NODE_ENV=development                    # Set to "production" to suppress debug logs